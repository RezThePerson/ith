package templates

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>

			<link rel="stylesheet" href="/static/style.css"/>

			<title>{ title } - ith</title>
		</head>
		<body>
			{ children... }

			@Footer()
		</body>
	</html>
}
